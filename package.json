{
  "name": "pi-extensions",
  "version": "0.1.0",
  "description": "A collection of extensions for Pi, the AI coding agent",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/natekift/pi-extensions.git"
  },
  "keywords": [
    "pi",
    "pi-extension",
    "pi-package",
    "coding-agent",
    "ai"
  ],
  "pi": {
    "extensions": [
      "./extensions/*/*.ts"
    ]
  },
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check . && tsc --noEmit && tsc --noEmit -p tsconfig.test.json && npm run validate && npm run test",
    "check:ci": "biome ci . && tsc --noEmit && tsc --noEmit -p tsconfig.test.json && npm run validate && npm run test",
    "validate": "tsx scripts/validate-all.ts",
    "validate:one": "tsx scripts/validate-cli.ts",
    "create": "tsx scripts/create-extension.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@earendil-works/gondolin": "^0.12.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.7",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
