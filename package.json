{
  "name": "pi-extensions",
  "version": "0.1.0",
  "description": "A collection of extensions for Pi, the AI coding agent",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nulluminati/pi-extensions.git"
  },
  "keywords": [
    "pi",
    "pi-extension",
    "pi-package",
    "coding-agent",
    "ai"
  ],
  "pi": {
    "extensions": [
      "./extensions/*/*.ts"
    ]
  },
  "scripts": {
    "prepare": "husky || true",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check . && tsc --noEmit --incremental && tsc --noEmit --incremental -p tsconfig.test.json && npm run validate && npm run test",
    "check:ci": "biome ci . && tsc --noEmit && tsc --noEmit -p tsconfig.test.json && npm run validate && npm run test",
    "validate": "node --import tsx scripts/validate-all.ts",
    "validate:one": "node --import tsx scripts/validate-cli.ts",
    "create": "tsx scripts/create-extension.ts",
    "test": "vitest run && npm run test:runtime",
    "test:runtime": "vitest run --config vitest.runtime.config.ts",
    "test:secrets": "node test/scripts/secret-scanning.mjs",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "lint-staged": {
    "*.{ts,js,mjs,json,jsonc}": "biome check --write --no-errors-on-unmatched"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.81"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@earendil-works/pi-agent-core": "^1.5.0",
    "@earendil-works/pi-ai": "^1.5.0",
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@earendil-works/pi-tui": "^1.5.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
