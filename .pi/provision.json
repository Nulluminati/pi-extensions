{
  "detect": { "any": ["package.json"] },
  "share": "hardlink-copy",
  "provision": "npm install --no-audit --no-fund",
  "network": [
    "registry.npmjs.org",
    "*.npmjs.org",
    "*.npmjs.com",
    "github.com",
    "objects.githubusercontent.com",
    "*.githubusercontent.com"
  ],
  "timeoutSeconds": 3600
}
