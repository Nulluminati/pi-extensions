#!/bin/sh
# Worktree setup hook: runs once per new worker worktree, inside the worker
# sandbox, before the worker spawns. Exit code decides the provision result.
# Setup scratch must use .pi/provision-tmp-XXXXXXXX (eight mktemp
# characters): Git exclusion and patch capture both discard paths with
# that name, and the tracked hook itself must not match it.
set -eu
# Keep package downloads in the worktree, not the sandbox's size-limited /tmp.
setup_dir=$(mktemp -d "$PWD/.pi/provision-tmp-XXXXXXXX")
trap 'rm -rf -- "$setup_dir"' EXIT
export TMPDIR="$setup_dir"
export npm_config_cache="$setup_dir/npm-cache"
# Native install scripts use Node's HTTPS client, which needs the sandbox
# proxy enabled explicitly. Keep existing Node options for package scripts.
# Husky cannot change the parent's read-only Git configuration in a worktree.
HUSKY=0 NODE_OPTIONS="${NODE_OPTIONS:+$NODE_OPTIONS }--use-env-proxy" npm install --no-audit --no-fund
